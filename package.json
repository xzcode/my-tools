{
  "name": "my-tools",
  "version": "0.6.2",
  "private": true,
  "license": "MIT",
  "description": "An offline personal developer toolbox for macOS, Windows and Linux.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "check": "npm run check:version && npm run test && npm run build",
    "test:e2e": "playwright test",
    "check:version": "node scripts/check-version.mjs",
    "desktop:ci": "node scripts/build-desktop.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.77.0",
    "@tauri-apps/api": "^2.12.5",
    "diff": "^9.0.0",
    "fflate": "0.8.2",
    "flag-icons": "7.6.0",
    "libphonenumber-js": "1.13.17",
    "lossless-json": "^4.3.4",
    "papaparse": "^5.7.1",
    "sql-formatter": "^15.9.1",
    "svga.lite": "1.6.1",
    "vue": "^3.5.45",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~5.9",
    "vite": "^7.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
